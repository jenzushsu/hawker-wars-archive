# Offline frontend needs no credentials.
# Trusted worker/API configuration only; never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Persistent supervisor selects an existing round; it never creates rounds.
HAWKER_ROUND_ID=
# Machine-only operator endpoint; generate at least 32 random bytes as base64url.
# Dedicated credential, separate from Supabase/provider keys. No browser storage.
HAWKER_OPERATOR_TOKEN=
HAWKER_OPERATOR_ID=
# Voting API (rules worker defaults off; new rounds opt in with --voting).
# Separate >=32-random-byte base64url signing key and exact HTTPS site origin.
HAWKER_VOTE_SESSION_KEY=
HAWKER_PUBLIC_ORIGIN=
# Provider credentials remain separately gated by docs/providers/activation.md.
